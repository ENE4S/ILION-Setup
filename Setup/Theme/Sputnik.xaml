<!-- ILION SETUP · tema SPUTNIK.
     Colores, medidas y tipografía tomados del modo SPUTNIK del menú de ILION (OptiScaler/menu/ilion_shell.inl, v1.4.1.1 SPUTNIK 4):
     rust 0.55/0.16/0.12 · rustLit 0.66/0.21/0.15 · sand 0.92/0.87/0.74 · sandPlate 0.66/0.64/0.50 · sandDim 0.62/0.60/0.50
     olive 0.24/0.26/0.18 · graphite 0.07/0.075/0.07 · frame 0.30/0.31/0.26 · well 0.06/0.06/0.055 · wellLit 0.13/0.13/0.11
     Controles rectangulares (FrameRounding 0), borde 1.5, títulos en Russo One (fBrand), textos en Bahnschrift (fUi).
     Pilotos de estado: verde ILION 0.69/1.00/0.10, amarillo 1.00/0.84/0.10, rojo 1.00/0.26/0.20 (ShellPal). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="C.Rust">#8C291F</Color>
    <Color x:Key="C.RustLit">#A83626</Color>
    <Color x:Key="C.Sand">#EBDEBD</Color>
    <Color x:Key="C.SandPlate">#A8A380</Color>
    <Color x:Key="C.SandDim">#9E9980</Color>
    <Color x:Key="C.Olive">#3D422E</Color>
    <Color x:Key="C.Graphite">#121312</Color>
    <Color x:Key="C.Frame">#4D4F42</Color>
    <Color x:Key="C.Dark">#171714</Color>
    <Color x:Key="C.Well">#0F0F0E</Color>
    <Color x:Key="C.WellLit">#21211C</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Graphite}"/>
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Dark}"/>
    <SolidColorBrush x:Key="B.PanelFace" Color="{StaticResource C.Graphite}"/>
    <SolidColorBrush x:Key="B.Raised" Color="{StaticResource C.WellLit}"/>
    <SolidColorBrush x:Key="B.Well" Color="{StaticResource C.Well}"/>
    <SolidColorBrush x:Key="B.Olive" Color="{StaticResource C.Olive}"/>
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Frame}"/>
    <SolidColorBrush x:Key="B.LineStrong" Color="{StaticResource C.SandPlate}"/>
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Sand}"/>
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.SandDim}"/>
    <SolidColorBrush x:Key="B.TextFaint" Color="#77735F"/>
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.RustLit}"/>
    <SolidColorBrush x:Key="B.Rust" Color="{StaticResource C.Rust}"/>
    <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.Sand}"/>
    <SolidColorBrush x:Key="B.Ok" Color="#B0FF1A"/>
    <SolidColorBrush x:Key="B.Warn" Color="#FFD61A"/>
    <SolidColorBrush x:Key="B.Yellow" Color="#FFD61A"/>
    <SolidColorBrush x:Key="B.Error" Color="#FF4233"/>
    <SolidColorBrush x:Key="B.AccentSoft" Color="#26A83626"/>
    <SolidColorBrush x:Key="B.WarnSoft" Color="#1FFFD61A"/>
    <SolidColorBrush x:Key="B.ErrorSoft" Color="#1FFF4233"/>

    <FontFamily x:Key="F.Ui">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Strong">Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="F.Brand">pack://application:,,,/Assets/#Russo One</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="T.Brand" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource F.Brand}"/><Setter Property="Foreground" Value="{StaticResource B.Text}"/></Style>
    <Style x:Key="T.Screen" TargetType="TextBlock" BasedOn="{StaticResource T.Brand}"><Setter Property="FontSize" Value="24"/></Style>
    <Style x:Key="T.Section" TargetType="TextBlock" BasedOn="{StaticResource T.Brand}"><Setter Property="FontSize" Value="18"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="T.Kicker" TargetType="TextBlock" BasedOn="{StaticResource T.Brand}"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource B.TextDim}"/></Style>
    <Style x:Key="T.Item" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource F.Strong}"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{StaticResource B.Text}"/></Style>
    <Style x:Key="T.Value" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource F.Strong}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource B.Text}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style x:Key="T.Note" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource F.Ui}"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource B.TextDim}"/></Style>
    <Style x:Key="T.Label" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource F.Strong}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource B.Text}"/></Style>

    <!-- Placa de sección: rectángulo con marco «frame» y la barra de óxido a la izquierda -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Panel}"/><Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1.5"/><Setter Property="Padding" Value="16,12,16,12"/>
    </Style>
    <Style x:Key="AccentBar" TargetType="Border">
        <Setter Property="Width" Value="5"/><Setter Property="Background" Value="{StaticResource B.Rust}"/><Setter Property="Margin" Value="0,2,12,2"/>
    </Style>

    <!-- Teclas: «well» con borde arena; al pasar, óxido (ImGuiCol_ButtonHovered = rust). Rectangulares, como SPUTNIK -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/><Setter Property="Background" Value="{StaticResource B.Well}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.LineStrong}"/><Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Brand}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="16,0"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource B.Rust}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource B.Accent}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource B.Text}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource B.Rust}"/><Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="BorderBrush" Value="{StaticResource B.Error}"/>
    </Style>
    <Style x:Key="Btn.Caption" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="20"/>
    </Style>

    <!-- Selector de modo (tres modos): placa oliva; el activo en óxido con texto arena -->
    <Style x:Key="Mode" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/><Setter Property="FontFamily" Value="{StaticResource F.Brand}"/>
        <Setter Property="FontSize" Value="16"/><Setter Property="Height" Value="44"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" Background="{StaticResource B.Olive}" BorderBrush="{StaticResource B.Line}" BorderThickness="1.5" Padding="18,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Text}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource B.Rust}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Casilla: pozo oscuro con borde arena; marcada, óxido (ImGuiCol_CheckMark = rustLit) -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" BorderThickness="1.5" BorderBrush="{StaticResource B.LineStrong}" Background="{StaticResource B.Well}" VerticalAlignment="Center">
                            <Border x:Name="Mark" Margin="3" Background="{StaticResource B.Accent}" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Text}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Text}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource B.Text}"/><Setter Property="FontFamily" Value="{StaticResource F.Ui}"/></Style>

    <!-- Desplegable rectangular (pozo + borde arena; lista en grafito) -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face" Background="{StaticResource B.Well}" BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1.5">
                        <TextBlock Text="▼" FontSize="10" Foreground="{StaticResource B.TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource B.Raised}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/><Setter Property="FontFamily" Value="{StaticResource F.Ui}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"/>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1.5" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="360">
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/><Setter Property="Padding" Value="12,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource B.Rust}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource B.Bg}"/><Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.LineStrong}"/><Setter Property="FontFamily" Value="{StaticResource F.Ui}"/><Setter Property="MaxWidth" Value="420"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
    </Style>
    <!-- Barra de desplazamiento fina, del mismo trazo -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb"><Border x:Name="T" Background="{StaticResource B.Line}"/>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource B.Rust}"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" Margin="1,0"/></Track.Thumb></Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/><Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" Margin="0,1"/></Track.Thumb></Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
